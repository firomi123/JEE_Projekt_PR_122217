# Copy to .env with `npm run env:init`: it generates every value marked
# "generated" and derives DATABASE_URL and S3_SECRET_KEY from them.
# .env is never committed.

# --- Backend (when run on the host with `npm run dev`) ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Reverse proxies in front of the API (0 on the host; Docker Compose sets 1 for nginx)
TRUST_PROXY=0
# Failed logins allowed per IP per 15 minutes
LOGIN_RATE_LIMIT_MAX=10
# GET /health returns 503 when the event loop was blocked longer than this (ms)
EVENT_LOOP_LAG_THRESHOLD_MS=1000

# --- PostgreSQL ---
POSTGRES_USER=driver
# generated
POSTGRES_PASSWORD=
POSTGRES_DB=driver_docs
# Host port, bound to 127.0.0.1 only
POSTGRES_PORT=5432
# Host-side URL for `npm run dev`; inside Docker Compose the backend gets a URL
# pointing at the `postgres` service instead. Derived by env:init.
DATABASE_URL=

# --- MinIO (S3) ---
MINIO_ROOT_USER=driver-minio
# generated
MINIO_ROOT_PASSWORD=
# Host ports, bound to 127.0.0.1 only (API and web console)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=documents
S3_ACCESS_KEY=driver-minio
# Derived by env:init (same as MINIO_ROOT_PASSWORD)
S3_SECRET_KEY=

# --- Security ---
# generated
JWT_SECRET=
JWT_EXPIRES_IN=1h
# 32-byte master key (base64) wrapping the per-file data keys (envelope encryption); generated
MASTER_ENCRYPTION_KEY=

# --- Office (dispatcher) account ---
# Created by the backend at startup (public registration always creates drivers).
# Same rules as registration: login 3-30 letters/digits/_, password 8+ characters
# with an uppercase letter, a digit and a special character. Leave both empty to
# run without an office account. Changing the password here updates it at the next start.
OFFICE_USERNAME=biuro
# generated
OFFICE_PASSWORD=
# Optional; defaults to <OFFICE_USERNAME>@office.invalid
OFFICE_EMAIL=

# --- Monitoring ---
GRAFANA_ADMIN_USER=admin
# generated
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3001
# Host port, bound to 127.0.0.1 only
PROMETHEUS_PORT=9090
# Host port, bound to 127.0.0.1 only
ALERTMANAGER_PORT=9093

# --- Frontend ---
# nginx serving the built app; proxies /api to the backend
FRONTEND_PORT=8090
