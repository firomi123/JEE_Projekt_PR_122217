# Copy to .env and fill in the secrets. .env is never committed.
# Variables are introduced stage by stage (see PLAN.md); unused ones are ignored for now.

# --- Backend ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- PostgreSQL (Stage 2/3) ---
POSTGRES_USER=driver
POSTGRES_PASSWORD=change-me
POSTGRES_DB=driver_docs
DATABASE_URL=postgresql://driver:change-me@localhost:5432/driver_docs

# --- MinIO (Stage 2/6) ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-minio
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=documents

# --- Security (Stage 4/6) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
# 32-byte master key (base64) used to wrap per-file data keys (envelope encryption)
MASTER_ENCRYPTION_KEY=

# --- Frontend ---
VITE_API_URL=http://localhost:3000
