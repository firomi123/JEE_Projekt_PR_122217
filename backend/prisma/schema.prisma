// Database schema of the driver document-management app.
// After every change: `npm run db:migrate -w backend -- --name <change>`.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

/// Account role: drivers register themselves; office accounts come from the
/// configuration (OFFICE_USERNAME / OFFICE_PASSWORD, Stage 15).
enum UserRole {
  DRIVER
  OFFICE
}

/// Application account. The driver profile (Stage 5) and documents (Stage 6)
/// reference it; passwords are stored only as argon2 hashes (Stage 4).
model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(30)
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash")
  role         UserRole @default(DRIVER)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile         DriverProfile?
  documents       Document[]
  createdVersions DocumentVersion[]
  historyEntries  DocumentHistory[]

  @@map("users")
}

/// Driver profile, exactly one per user (created together with the account).
/// Every field is optional until the driver fills it in.
model DriverProfile {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName     String?  @map("first_name") @db.VarChar(50)
  lastName      String?  @map("last_name") @db.VarChar(80)
  phone         String?  @db.VarChar(16)
  licenseNumber String?  @map("license_number") @db.VarChar(20)
  companyName   String?  @map("company_name") @db.VarChar(120)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("driver_profiles")
}

enum DocumentType {
  CMR
  WZ
  INVOICE
  OTHER
}

enum DocumentStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
  ARCHIVED
}

enum HistoryAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  VERSION_ADDED
  DELETED
}

/// A transport document (CMR, WZ, …) owned by one driver. Deleting is soft
/// (`deletedAt`), so the encrypted files and the history are kept.
model Document {
  id             String            @id @default(uuid()) @db.Uuid
  ownerId        String            @map("owner_id") @db.Uuid
  owner          User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type           DocumentType
  status         DocumentStatus    @default(DRAFT)
  title          String            @db.VarChar(200)
  number         String?           @db.VarChar(50)
  currentVersion Int               @default(1) @map("current_version")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz(3)
  versions       DocumentVersion[]
  history        DocumentHistory[]

  @@index([ownerId, deletedAt, updatedAt])
  @@map("documents")
}

/// One uploaded file of a document. The file is stored in MinIO encrypted with its
/// own random data key (AES-256-GCM); that key is stored here encrypted with the
/// master key (envelope encryption).
model DocumentVersion {
  id               String   @id @default(uuid()) @db.Uuid
  documentId       String   @map("document_id") @db.Uuid
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNo        Int      @map("version_no")
  storageKey       String   @unique @map("storage_key") @db.VarChar(255)
  mimeType         String   @map("mime_type") @db.VarChar(100)
  sizeBytes        Int      @map("size_bytes")
  /// Hex SHA-256 of the original (plaintext) file.
  sha256           String   @db.Char(64)
  /// 12-byte GCM nonce used to encrypt the file.
  iv               Bytes
  /// 16-byte GCM authentication tag of the encrypted file.
  authTag          Bytes    @map("auth_tag")
  /// Data key encrypted with the master key: nonce (12) || ciphertext (32) || tag (16).
  encryptedDataKey Bytes    @map("encrypted_data_key")
  changeNote       String?  @map("change_note") @db.VarChar(500)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById      String   @map("created_by_id") @db.Uuid
  createdBy        User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNo])
  @@map("document_versions")
}

/// Change log of a document: who changed what, when, from which value to which.
model DocumentHistory {
  id          String        @id @default(uuid()) @db.Uuid
  documentId  String        @map("document_id") @db.Uuid
  document    Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  changedById String        @map("changed_by_id") @db.Uuid
  changedBy   User          @relation(fields: [changedById], references: [id], onDelete: Cascade)
  action      HistoryAction
  field       String?       @db.VarChar(30)
  oldValue    String?       @map("old_value") @db.VarChar(500)
  newValue    String?       @map("new_value") @db.VarChar(500)
  /// Office's comment on a review decision (required when rejecting).
  comment     String?       @db.VarChar(500)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([documentId, createdAt])
  @@map("document_history")
}
